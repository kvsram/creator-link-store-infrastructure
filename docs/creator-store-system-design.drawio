<mxfile host="Electron" modified="2026-09-02T18:00:00.000Z" agent="Codex" version="28.2.8" type="device" pages="12">
  <diagram id="roadmap" name="00 - Evolution roadmap">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="Creator Store (Stan-like) — simplest flow first, scale only for measured pressure" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="160" y="30" width="1280" height="50" as="geometry"/></mxCell>
        <mxCell id="s1" value="STAGE A — PRODUCT BASELINE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="115" width="440" height="55" as="geometry"/></mxCell>
        <mxCell id="a1" value="1. Identity &amp; onboarding&lt;br&gt;Creator account, session, tenant boundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="110" y="205" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="a2" value="2. Publish &amp; view storefront&lt;br&gt;Products, promotions, themes, pinning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="110" y="325" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="a3" value="3. Product-specific workflows&lt;br&gt;Downloads, meetings, courses, webinars" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="110" y="445" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="s2" value="STAGE B — COMMERCE &amp; AUTOMATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="115" width="440" height="55" as="geometry"/></mxCell>
        <mxCell id="b1" value="4. Checkout &amp; payments&lt;br&gt;Razorpay, webhook truth, ledger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="1"><mxGeometry x="610" y="205" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="b2" value="5. Fulfillment &amp; entitlements&lt;br&gt;Files, booking, course access, membership" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="1"><mxGeometry x="610" y="325" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="b3" value="6. Customers, analytics &amp; income&lt;br&gt;Events, attribution, rollups, reconciliation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="610" y="445" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="b4" value="7. Instagram AutoDM&lt;br&gt;Signed webhooks, rules, queue, rate limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1"><mxGeometry x="610" y="565" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="s3" value="STAGE C — PRODUCTION SCALE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="115" width="440" height="55" as="geometry"/></mxCell>
        <mxCell id="c1" value="8. Single-region production&lt;br&gt;CDN/WAF, EKS, RDS, S3, SQS, observability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1110" y="205" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="c2" value="9. High-read / high-write evolution&lt;br&gt;Cache, read replicas, async event ingestion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1110" y="325" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="c3" value="10. Multi-region &amp; disaster recovery&lt;br&gt;Home writer region, global reads, tested failover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1110" y="445" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="n" value="Rule: do not introduce WebSockets, queues, Redis, microservices, or multi-region writes until a feature or measured bottleneck needs them." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="735" width="1000" height="70" as="geometry"/></mxCell>
