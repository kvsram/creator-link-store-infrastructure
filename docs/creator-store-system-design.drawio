        <mxCell id="runner" value="Private GitHub Actions runner / GitOps controller&lt;br&gt;reaches private EKS API; uses OIDC, never long-lived AWS keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="610" width="470" height="100" as="geometry"/></mxCell>
