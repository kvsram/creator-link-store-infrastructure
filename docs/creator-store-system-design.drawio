  <diagram id="analytics-queue" name="04A - Why analytics needs a queue">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="Analytics queue: not needed first — introduced to isolate viral write bursts" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="25" width="1180" height="50" as="geometry"/></mxCell>
        <mxCell id="low" value="LOW SCALE — current/simple path" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#f5f5f5;strokeColor=#666666;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="700" height="300" as="geometry"/></mxCell>
        <mxCell id="lv" value="Visitor&lt;br&gt;opens /alex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="225" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="la" value="Event API&lt;br&gt;small validated event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="215" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="ldb" value="PostgreSQL&lt;br&gt;INSERT store_visits / click_events" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="535" y="205" width="180" height="110" as="geometry"/></mxCell>
        <mxCell id="le1" value="POST event" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="lv" target="la"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le2" value="direct write" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="la" target="ldb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ln" value="Good enough while event writes are small and DB latency/connection use stay healthy. No queue required." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="340" width="540" height="45" as="geometry"/></mxCell>
        <mxCell id="viral" value="EXAMPLE PROBLEM — viral creator post" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#f5f5f5;strokeColor=#666666;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="110" width="700" height="300" as="geometry"/></mxCell>
        <mxCell id="ex" value="Example: 250,000 visits in 5 minutes&lt;br&gt;≈ 833 visitors/sec&lt;br&gt;3 analytics events each ≈ 2,500 writes/sec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="205" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="sat" value="Without isolation&lt;br&gt;DB connection pool fills&lt;br&gt;random inserts increase I/O&lt;br&gt;storefront + checkout slow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1200" y="205" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="xe" value="burst" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="ex" target="sat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="high" value="HIGH WRITE — isolated asynchronous path" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#f5f5f5;strokeColor=#666666;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="490" width="1360" height="300" as="geometry"/></mxCell>
        <mxCell id="api" value="Event API&lt;br&gt;validate + enqueue quickly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="180" y="610" width="190" height="85" as="geometry"/></mxCell>
        <mxCell id="q" value="SQS / Kinesis&lt;br&gt;absorbs burst + backpressure&lt;br&gt;durable retry / DLQ" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="450" y="595" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="batch" value="Consumer micro-batches&lt;br&gt;e.g. 500 events per DB operation&lt;br&gt;bounded concurrency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="770" y="595" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="stores" value="Raw S3 + rollup store&lt;br&gt;partitioned, deduplicated&lt;br&gt;dashboard reads aggregates" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1090" y="590" width="230" height="125" as="geometry"/></mxCell>
        <mxCell id="he1" value="milliseconds" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="api" target="q"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he2" value="consume at safe rate" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="q" target="batch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he3" value="batch writes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="batch" target="stores"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rule" value="Failure rule: analytics is optional for serving the page. If enqueue fails, record a metric/sample locally and still return the storefront; never make a visitor wait for reporting." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="740" width="940" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

