        <mxCell id="rds" value="Private RDS / Aurora PostgreSQL&lt;br&gt;Multi-AZ writer + standby&lt;br&gt;encrypted backups + PITR" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="625" width="230" height="130" as="geometry"/></mxCell>
