  <diagram id="multi" name="08 - Multi-region evolution">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="Two-to-three region evolution — global reads, controlled writes, tested failover" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="25" width="1240" height="50" as="geometry"/></mxCell>
        <mxCell id="edge" value="Route 53 / Global Accelerator&lt;br&gt;CloudFront + WAF&lt;br&gt;health-based routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="360" height="105" as="geometry"/></mxCell>
        <mxCell id="ra" value="REGION A — PRIMARY / HOME WRITER" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="450" height="390" as="geometry"/></mxCell>
        <mxCell id="aeks" value="EKS frontend + public API + command API + workers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="105" y="405" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="adb" value="Aurora Global DB&lt;br&gt;writer cluster" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="150" y="545" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="aredis" value="Regional Redis&lt;br&gt;disposable cache" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="355" y="545" width="130" height="100" as="geometry"/></mxCell>
        <mxCell id="rb" value="REGION B — ACTIVE READ / WARM WRITE" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="575" y="300" width="450" height="390" as="geometry"/></mxCell>
        <mxCell id="beks" value="EKS frontend + public API&lt;br&gt;command API routes creator to home region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="400" width="360" height="90" as="geometry"/></mxCell>
        <mxCell id="bdb" value="Aurora Global DB&lt;br&gt;read-only secondary" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="670" y="545" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="bredis" value="Regional Redis&lt;br&gt;disposable cache" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="875" y="545" width="130" height="100" as="geometry"/></mxCell>
        <mxCell id="rc" value="REGION C — OPTIONAL READ / DR" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="300" width="450" height="390" as="geometry"/></mxCell>
        <mxCell id="ceks" value="EKS frontend + public API&lt;br&gt;scaled small until promotion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1135" y="400" width="360" height="90" as="geometry"/></mxCell>
        <mxCell id="cdb" value="Aurora Global DB&lt;br&gt;read-only secondary" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1185" y="545" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="credis" value="Regional Redis&lt;br&gt;disposable cache" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1390" y="545" width="130" height="100" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="edge" target="aeks"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="edge" target="beks"><mxGeometry relative="1" as="geometry"/></mxCell>
