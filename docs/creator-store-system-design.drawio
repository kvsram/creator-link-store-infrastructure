        <mxCell id="eks" value="Private EKS managed nodes" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="300" width="760" height="250" as="geometry"/></mxCell>
        <mxCell id="front" value="Frontend pods&lt;br&gt;NGINX / React" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="770" y="410" width="170" height="75" as="geometry"/></mxCell>
        <mxCell id="api" value="API pods&lt;br&gt;Spring Boot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1010" y="410" width="170" height="75" as="geometry"/></mxCell>
