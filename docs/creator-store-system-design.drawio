  <diagram id="data" name="06 - Domain and data model">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="Modular monolith boundaries and owned data" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="30" width="1000" height="50" as="geometry"/></mxCell>
        <mxCell id="id" value="IDENTITY&lt;br&gt;&lt;br&gt;creators&lt;br&gt;creator_roles&lt;br&gt;sessions&lt;br&gt;audit_events&lt;br&gt;notification_preferences" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="230" height="230" as="geometry"/></mxCell>
        <mxCell id="cat" value="CATALOG / STORE&lt;br&gt;&lt;br&gt;stores&lt;br&gt;products&lt;br&gt;promotions&lt;br&gt;product_files&lt;br&gt;checkout_fields&lt;br&gt;reviews" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="130" width="230" height="250" as="geometry"/></mxCell>
        <mxCell id="com" value="COMMERCE&lt;br&gt;&lt;br&gt;checkouts&lt;br&gt;payment_events&lt;br&gt;orders&lt;br&gt;order_items&lt;br&gt;ledger_entries&lt;br&gt;refunds / disputes&lt;br&gt;settlements" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="130" width="230" height="270" as="geometry"/></mxCell>
        <mxCell id="ful" value="FULFILLMENT&lt;br&gt;&lt;br&gt;entitlements&lt;br&gt;downloads&lt;br&gt;bookings&lt;br&gt;enrollments&lt;br&gt;course_progress&lt;br&gt;subscriptions" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="830" y="130" width="230" height="250" as="geometry"/></mxCell>
        <mxCell id="aud" value="AUDIENCE&lt;br&gt;&lt;br&gt;customers&lt;br&gt;leads&lt;br&gt;consents&lt;br&gt;tags&lt;br&gt;suppressions&lt;br&gt;email_flows" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="130" width="220" height="240" as="geometry"/></mxCell>
        <mxCell id="auto" value="AUTOMATION&lt;br&gt;&lt;br&gt;integrations&lt;br&gt;automations&lt;br&gt;automation_rules&lt;br&gt;inbound_events&lt;br&gt;outbound_actions&lt;br&gt;delivery_attempts" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1340" y="130" width="220" height="250" as="geometry"/></mxCell>
        <mxCell id="ana" value="ANALYTICS&lt;br&gt;&lt;br&gt;store_visits&lt;br&gt;click_events&lt;br&gt;attribution_events&lt;br&gt;daily_creator_metrics&lt;br&gt;promotion_metrics" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="535" width="260" height="220" as="geometry"/></mxCell>
        <mxCell id="plat" value="PLATFORM / RELIABILITY&lt;br&gt;&lt;br&gt;outbox_events&lt;br&gt;idempotency_keys&lt;br&gt;job_attempts&lt;br&gt;schema_history&lt;br&gt;data_retention_jobs" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="910" y="535" width="270" height="220" as="geometry"/></mxCell>
