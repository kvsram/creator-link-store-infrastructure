# Requires External Secrets Operator and an IRSA role that can read only this secret.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: creator-store-runtime-secrets
  namespace: creator-store
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: aws-secrets-manager
    kind: ClusterSecretStore
  target:
    name: creator-store-runtime-secrets
    creationPolicy: Owner
  # The remote secret must expose exactly these properties. Keep URLs, sender
  # addresses, and feature switches in ConfigMap overlays; keep credentials and
  # the auth fingerprint key here. Never place the values in Git.
  data:
    - secretKey: DB_URL
      remoteRef:
        key: creator-store/prod/runtime
        property: DB_URL
    - secretKey: DB_USER
      remoteRef:
        key: creator-store/prod/runtime
        property: DB_USER
    - secretKey: DB_PASSWORD
      remoteRef:
        key: creator-store/prod/runtime
        property: DB_PASSWORD
    - secretKey: APP_AUTH_FINGERPRINT_SECRET
      remoteRef:
        key: creator-store/prod/runtime
        property: APP_AUTH_FINGERPRINT_SECRET
    - secretKey: SMTP_USERNAME
      remoteRef:
        key: creator-store/prod/runtime
        property: SMTP_USERNAME
    - secretKey: SMTP_PASSWORD
      remoteRef:
        key: creator-store/prod/runtime
        property: SMTP_PASSWORD
