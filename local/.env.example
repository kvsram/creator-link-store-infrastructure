# Copy to local/.env and keep it untracked. Use provider TEST credentials only.
PAYMENTS_MODE=disabled
PAYMENTS_DEFAULT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

INSTAGRAM_MODE=disabled
INSTAGRAM_GRAPH_API_VERSION=v23.0
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
# Comma-separated Instagram-scoped user IDs allowed during test mode.
INSTAGRAM_TEST_RECIPIENT_IDS=
