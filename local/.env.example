# Copy to local/.env and keep it untracked. Use provider TEST credentials only.
# These auth values are development-only. Local email is captured by Mailpit and
# never leaves the laptop. Replace the fingerprint value before sharing a stack.
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_AUTH_PUBLIC_BASE_URL=http://localhost:3000
APP_AUTH_EMAIL_FROM=no-reply@creator-store.local
APP_AUTH_EMAIL_FROM_NAME=Creator Store Local
APP_AUTH_DELIVERY_POLL_MS=500
APP_AUTH_FINGERPRINT_SECRET=local-only-fingerprint-secret-change-before-shared-use
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_READ_TIMEOUT_MS=10000
SMTP_WRITE_TIMEOUT_MS=10000

PAYMENTS_MODE=disabled
PAYMENTS_DEFAULT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

INSTAGRAM_MODE=disabled
INSTAGRAM_GRAPH_API_VERSION=v23.0
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
# Comma-separated Instagram-scoped user IDs allowed during test mode.
INSTAGRAM_TEST_RECIPIENT_IDS=
